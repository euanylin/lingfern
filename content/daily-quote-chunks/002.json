[{"id":"wikiquote-d9225836a2ee605c695c3e452e51e67c2aa6b9259a680fe1ea4082b0dc45ac8f","text":"God made him, and therefore let him pass for a man.","pageTitle":"The Merchant of Venice","locator":"Portia, l. 50","url":"https://en.wikiquote.org/w/index.php?oldid=3952634#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-2240e2fa2d1be18cf1562c607f7f7fa9ea6a6b9b6c12693245ec3300b32261d2","text":"I dote on his very absence.","pageTitle":"The Merchant of Venice","locator":"Portia, l. 99","url":"https://en.wikiquote.org/w/index.php?oldid=3952634#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-d6c4d01f5cf3fb35cc7032e5342db55d64ec1fe6b47a046dfcfb3fa2c1714040","text":"I like not fair terms and a villain's mind.","pageTitle":"The Merchant of Venice","locator":"Bassanio, l. 174","url":"https://en.wikiquote.org/w/index.php?oldid=3952634#Scene_iii","rightsEvidence":{}},{"id":"wikiquote-1721054d22e03f55962f81f8f534702622faeda8d3abc86541316f4fbcadb7dd","text":"I think he only loves the world for him.","pageTitle":"The Merchant of Venice","locator":"Salanio, of Antonio's love for Bassanio; l. 50","url":"https://en.wikiquote.org/w/index.php?oldid=3952634#Scene_viii","rightsEvidence":{}},{"id":"wikiquote-17ff3bb90cf8bcfe833da268abd17f865c61cf1f41c6b8b936c6ff68b6b33f4b","text":"I never knew so young a body with so old a head.","pageTitle":"The Merchant of Venice","locator":"Clerk, reading; l. 160","url":"https://en.wikiquote.org/w/index.php?oldid=3952634#Scene_i","rightsEvidence":{}},{"id":"wikiquote-a64701fd07e54ba6de65baf44a2d6159264c75fdba6d27174e8d658c25127705","text":"I am content.","pageTitle":"The Merchant of Venice","locator":"Shylock, l. 382","url":"https://en.wikiquote.org/w/index.php?oldid=3952634#Scene_i","rightsEvidence":{}},{"id":"wikiquote-b7e471e21172c1196061536b5d63f4ee9cc8182ddc57b7e829c5edc4c3085c52","text":"I am never merry when I hear sweet music.","pageTitle":"The Merchant of Venice","locator":"Jessica, l. 69","url":"https://en.wikiquote.org/w/index.php?oldid=3952634#Scene_i","rightsEvidence":{}},{"id":"wikiquote-4152ec4ab6bc52994729543de698c0a68592afc5d98a424ca1bba69ae8a5d8bb","text":"I would my father look’d but with my eyes.","pageTitle":"A Midsummer Night's Dream","locator":"Hermia, l. 56","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_i","rightsEvidence":{}},{"id":"wikiquote-7815b4fd178b7b38f431cf61c4adc1805dc06807fdbff896c87b95a7ff7f2c02","text":"Masters, spread yourselves.","pageTitle":"A Midsummer Night's Dream","locator":"Bottom, l. 14","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-3b614619c6d568f6202366ac289f8d946273b7b90f2c85cde4ad7d62fe1470b2","text":"I am slow of study.","pageTitle":"A Midsummer Night's Dream","locator":"Snug, l. 59","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-cbe1b9bb4865f9d8ea0e746907c26688c4d44e6ac7fe78a094a3c9f2fba04931","text":"I will roar you as gently as any sucking dove; I will roar you an ’twere any nightingale.","pageTitle":"A Midsummer Night's Dream","locator":"Bottom, l. 73","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-aa08c6707d6daa5fff3116ec446632969aedc31b420cdb94eea56a64ea4da7bd","text":"I am that merry wanderer of the night.","pageTitle":"A Midsummer Night's Dream","locator":"Puck, l. 43","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_i","rightsEvidence":{}},{"id":"wikiquote-ecfd6134e7ba2427b26e6869f38afc599dcfeb9f5dc39632d07a0320e52852db","text":"Ill met by moonlight, proud Titania.","pageTitle":"A Midsummer Night's Dream","locator":"Oberon, l. 60","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_i","rightsEvidence":{}},{"id":"wikiquote-cfea1f2052cdc512f891e360a03b27b041856fc89373340c8eabbc357f2e44b8","text":"My mistress with a monster is in love.","pageTitle":"A Midsummer Night's Dream","locator":"Puck, l. 6","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-cfefa9796a9c4da86cf8ef41164da658f839baaefa22af5891a4c4f2c0ae415e","text":"There is no following her in this fierce vein.","pageTitle":"A Midsummer Night's Dream","locator":"Demetrius, l. 82, of Hermia","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-20d75b5a36d01798040a8d680d94bb455b7f662e09e0edeade9c40b834fbbdfc","text":"Lord, what fools these mortals be!","pageTitle":"A Midsummer Night's Dream","locator":"Puck, l. 115","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-b800215d89da93ed3f5bf19a0e2998adc4893e57d2f6755676fbb74b34fe2e46","text":"I am such a tender ass, if my hair do but tickle me, I must scratch.","pageTitle":"A Midsummer Night's Dream","locator":"Bottom, l. 22","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_i","rightsEvidence":{}},{"id":"wikiquote-68af9e587986b7f5f6566a5d4397b9d05a2f1105d98837a4fdb11dea98d2fd28","text":"I have an exposition of sleep come upon me.","pageTitle":"A Midsummer Night's Dream","locator":"Bottom, l. 36","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_i","rightsEvidence":{}},{"id":"wikiquote-40634222a95641a5caf51af4a4205a3c020e4856559238240b1d66954f5e6793","text":"My love shall hear the music of my hounds.","pageTitle":"A Midsummer Night's Dream","locator":"Theseus, l. 103","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_i","rightsEvidence":{}},{"id":"wikiquote-9194155692d300721f1e7c1f3f813c5e041f612226f555f1b47fdc48d2fff5e5","text":"I have had a dream, past the wit of man to say what dream it was.","pageTitle":"A Midsummer Night's Dream","locator":"Bottom, l. 201","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_i","rightsEvidence":{}},{"id":"wikiquote-2a9d40ecaafca8fdd95edafb66ced57c97f113368f9de601644fc869f6803cbe","text":"The best in this kind are but shadows; and the worst are no worse, if imagination amend them.","pageTitle":"A Midsummer Night's Dream","locator":"Theseus, l. 210","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_i","rightsEvidence":{}},{"id":"wikiquote-006e2954ed35e56c9824893b75ec967936c35dec4db056e901b1e48a88529fc9","text":"A very gentle beast, and of a good conscience.","pageTitle":"A Midsummer Night's Dream","locator":"Theseus, l. 224","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_i","rightsEvidence":{}},{"id":"wikiquote-6387e0ef0b5f28e10a9260ef3b852d9568f9c772b9659f4f105c78d48ae540e1","text":"No epilogue, I pray you; for your play needs no excuse.","pageTitle":"A Midsummer Night's Dream","locator":"Theseus, l. 345","url":"https://en.wikiquote.org/w/index.php?oldid=3756904#Scene_i","rightsEvidence":{}},{"id":"wikiquote-a5737051ade066dfd620762c02c08259e98e68f1bf00659ba6f3672c043616e5","text":"A victory is twice itself when the achiever brings home full numbers.","pageTitle":"Much Ado About Nothing","locator":"Leonato, l. 8","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_i","rightsEvidence":{}},{"id":"wikiquote-a9039ba339790a30a55c17d0a0161ef8265b09b604deafb86a57e520686b5cd6","text":"I had rather hear my dog bark at a crow than a man swear he loves me.","pageTitle":"Much Ado About Nothing","locator":"Beatrice, l. 113","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_i","rightsEvidence":{}},{"id":"wikiquote-8d68bd1828e9129595e2e7e141b3778a18227cf887ca44612d9150f20a22ca03","text":"I would my horse had the speed of your tongue, and so good a continuer.","pageTitle":"Much Ado About Nothing","locator":"Benedick, l. 120","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_i","rightsEvidence":{}},{"id":"wikiquote-1a830e0d93dfd92f783b9b6311a094690450e2861c475ea78c8cc15b25ddc32e","text":"I dare swear he is no hypocrite, but prays from his heart.","pageTitle":"Much Ado About Nothing","locator":"Don Pedro, l. 126","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_i","rightsEvidence":{}},{"id":"wikiquote-a08135a60ab4467fb9e8b95f0124e226764f81bc831459aea913a7f118f4eacf","text":"Do you question me, as an honest man should do, for my simple true judgment; or would you have me speak after my custom, as being a professed tyrant to their sex?","pageTitle":"Much Ado About Nothing","locator":"Benedick, l. 141","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_i","rightsEvidence":{}},{"id":"wikiquote-efa0def39487cc3eeb522f1ec4b63595e64250dcebe55e21a185e060b0007e58","text":"Shall I never see a bachelor of threescore again?","pageTitle":"Much Ado About Nothing","locator":"Benedick, l. 170","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_i","rightsEvidence":{}},{"id":"wikiquote-ef4ac75713723dbfb63fceda9c9a0fa6bb68e56ccd58e8fb26d76e40e65f24da","text":"He is of a very melancholy disposition.","pageTitle":"Much Ado About Nothing","locator":"Hero, l. 5","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_i","rightsEvidence":{}},{"id":"wikiquote-ea2de9e9b9823ec75f3723bb1b9db00cce9d718ba71c4c4455f6ea0f812f824e","text":"I could not endure a husband with a beard on his face: I had rather lie in the woollen.","pageTitle":"Much Ado About Nothing","locator":"Beatrice, l. 25","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_i","rightsEvidence":{}},{"id":"wikiquote-d2a0014e3b10477ab503c3d39f325a4f723caea2cca4f43627fee1e4a94b199f","text":"Speak low, if you speak love.","pageTitle":"Much Ado About Nothing","locator":"Don Pedro, l. 85","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_i","rightsEvidence":{}},{"id":"wikiquote-036f31befc9d3f275f76a877fe83e193828bbbf04b60bbfe8d5df31f1d7bc6ab","text":"I was born to speak all mirth and no matter.","pageTitle":"Much Ado About Nothing","locator":"Beatrice, l. 296","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_i","rightsEvidence":{}},{"id":"wikiquote-62782b3924bba3177b6fc44f544d48ca3d9ad1fd5aceb937fb4fe00ccb494b7d","text":"Silence is the perfectest herald of joy: I were but little happy, if I could say how much.","pageTitle":"Much Ado About Nothing","locator":"Claudio, l. 275","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_i","rightsEvidence":{}},{"id":"wikiquote-1c2608e427cb6be5d488aad684783ac51192ee4e31210cb84c0fec8616a68a42","text":"Sits the wind in that corner?","pageTitle":"Much Ado About Nothing","locator":"Benedick, l. 91","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_iii","rightsEvidence":{}},{"id":"wikiquote-c04282fd09511c8e075ed3cac89997a7a1809c4a1e39c2832d890db6af6a702d","text":"A man loves the meat in his youth that he cannot endure in his age.","pageTitle":"Much Ado About Nothing","locator":"Benedick, l. 217","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_iii","rightsEvidence":{}},{"id":"wikiquote-eeb832d27bf6c335b5c76992e4ee35ffcc249ff8ad3920ee8a3b892047450ad2","text":"Are you good men and true?","pageTitle":"Much Ado About Nothing","locator":"Dogberry, l. 1","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_iii","rightsEvidence":{}},{"id":"wikiquote-bf2f28fcf38ca201ebd798b5262faaf1e9f5f180b8dd444b7d1f8285a5854fc6","text":"Is our whole dissembly appeared?","pageTitle":"Much Ado About Nothing","locator":"Dogberry, l. 1","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-ff1a3e08eaf35e60893c7a00da5cab5beedbddf08cdc1be9e5e8c8b8f51de12c","text":"Yea, marry, that's the eftest way.","pageTitle":"Much Ado About Nothing","locator":"Dogberry, l. 32","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-c76e70f2b4e509874f3a5190a53086ee29d9e2d5940a128d17a5f4ee4cb93474","text":"Therein do men from children nothing differ.","pageTitle":"Much Ado About Nothing","locator":"Antonio, l. 33","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_i","rightsEvidence":{}},{"id":"wikiquote-0b440ee25459dacf436157c6d61884bdd4eaf79f78ae0497df61a53e51b814b0","text":"In a false quarrel there is no true valour.","pageTitle":"Much Ado About Nothing","locator":"Benedick, l. 120","url":"https://en.wikiquote.org/w/index.php?oldid=3886259#Scene_i","rightsEvidence":{}},{"id":"wikiquote-e8e7052d8b2518a6bfdae2f3267138a8680809ffbd08fc2ae0c4c3163f03af44","text":"Off with his head!","pageTitle":"Richard III (play)","locator":"Richard, Duke of Gloucester, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3937287#Act_III","rightsEvidence":{}},{"id":"wikiquote-fc7e17a0036e8e4c88e86d42e34d5e7d16bae48abcf11e72e2dc802ffdb574cd","text":"Despair and die!","pageTitle":"Richard III (play)","locator":"The Ghosts of Edward of Wales; Henry VI; Clarence; Grey; Rivers; Vaughan; Hastings; The Princes; Anne and Buckingham, scene iii","url":"https://en.wikiquote.org/w/index.php?oldid=3937287#Act_V","rightsEvidence":{}},{"id":"wikiquote-3ea24ef75c5d802f077c96edceea88dec66cfe97d9f7e6831d88144f6fc6213d","text":"A thing devised by the enemy.","pageTitle":"Richard III (play)","locator":"King Richard, scene iii","url":"https://en.wikiquote.org/w/index.php?oldid=3937287#Act_V","rightsEvidence":{}},{"id":"wikiquote-1d7f4e83ee61f8891ec90a5f721622087105df6ec7a995e8c1d4a819d6bac762","text":"A horse! A horse! My kingdom for a horse!","pageTitle":"Richard III (play)","locator":"King Richard, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3937287#Act_V","rightsEvidence":{}},{"id":"wikiquote-2accd77cbb86faa04b03186a2ee148db73739f1cc81245f334b1c822021ad111","text":"To me she's married, not unto my clothes.","pageTitle":"The Taming of the Shrew","locator":"Petruchio scene III","url":"https://en.wikiquote.org/w/index.php?oldid=3856277#Act_III","rightsEvidence":{}},{"id":"wikiquote-5830e1d065ea4b35ec2fc476f8aded62ab69bad9f3d6701a03b646e3b8383d0d","text":"I am sure care's an enemy to life.","pageTitle":"Twelfth Night","locator":"Sir Toby scene iii","url":"https://en.wikiquote.org/w/index.php?oldid=3447375#Act_I","rightsEvidence":{}},{"id":"wikiquote-1c84cf9d6c68bc67d8dd1e9240dbe7ac71166e3db459dbf0b521c23e3235d425","text":"Wherefore are these things hid? Wherefore have these gifts a curtain before 'em?","pageTitle":"Twelfth Night","locator":"Sir Toby, scene iii","url":"https://en.wikiquote.org/w/index.php?oldid=3447375#Act_I","rightsEvidence":{}},{"id":"wikiquote-e05c1d5c597473dbb7a6cf05ae50c118eb71898e4b84d2b491a8a855aff39717","text":"Is it a world to hide virtues in?","pageTitle":"Twelfth Night","locator":"Sir Toby, scene iii","url":"https://en.wikiquote.org/w/index.php?oldid=3447375#Act_I","rightsEvidence":{}},{"id":"wikiquote-b2f4e3cd50334177d8cdda5bfe4a62345ec5bf02ba30d23e187b20458e30ed4b","text":"Some are born great, some achieve greatness, and some have greatness thrust upon 'em.","pageTitle":"Twelfth Night","locator":"Malvolio, scene v Malvolio is reading aloud a letter which he believes to be from Olivia. Parodied in Joseph Heller, Catch-22, Chapter 9, as “Some men are born mediocre, some men achieve mediocrity, and some men have mediocrity thrust upon them.”","url":"https://en.wikiquote.org/w/index.php?oldid=3447375#Act_II","rightsEvidence":{}},{"id":"wikiquote-59e6da2baaf653d93219994ba4412b27c133cd63cb5bf7bbac22d20598b6be27","text":"I think we do know the sweet Roman hand.","pageTitle":"Twelfth Night","locator":"Malvolio, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3447375#Act_III","rightsEvidence":{}},{"id":"wikiquote-497d5e4be0a8ace19af68945dd8e97df808da5b2e7ffe5bad45cf5e9359f0512","text":"Why, this is very midsummer madness.","pageTitle":"Twelfth Night","locator":"Olivia, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3447375#Act_III","rightsEvidence":{}},{"id":"wikiquote-a9382fce7f03c54c91f1b8afb5b8763a5a9c199398ca77faaf137f8305f6c4d9","text":"If this were played upon a stage now, I could condemn it as an improbable fiction.","pageTitle":"Twelfth Night","locator":"Fabian, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3447375#Act_III","rightsEvidence":{}},{"id":"wikiquote-f107e27c59c7976202718519ea83310c7f245ce701910ecf36caf4dfbc9a2440","text":"More matter for a May morning.","pageTitle":"Twelfth Night","locator":"Fabian, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3447375#Act_III","rightsEvidence":{}},{"id":"wikiquote-c2bd38e7d66f2c0f98e2db0abe0fc3244ffb5a80bee143c9c2db7bdab8a671f1","text":"Home-keeping youth have ever homely wits.","pageTitle":"The Two Gentlemen of Verona","locator":"Valentine, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3193540#Act_I","rightsEvidence":{}},{"id":"wikiquote-9ef7b9200ec3e73da8eebf5ad5e8f4af481ec9ac0998d9a0e53dd6fd4c9995a4","text":"I was in love with my bed.","pageTitle":"The Two Gentlemen of Verona","locator":"Speed, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3193540#Act_II","rightsEvidence":{}},{"id":"wikiquote-eedfc7f1077a010a41b0320ce4dff1e99c65c5443daf5482939cedd04e420571","text":"And if it please you, so; if not, why, so.","pageTitle":"The Two Gentlemen of Verona","locator":"Silvia, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3193540#Act_II","rightsEvidence":{}},{"id":"wikiquote-c50725eee91aa7cb8e1a713fde76a9a10dc81b89aa2729e5dd85700185c5a0e6","text":"A fine volley of words, gentlemen, and quickly shot off.","pageTitle":"The Two Gentlemen of Verona","locator":"Silvia, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3193540#Act_II","rightsEvidence":{}},{"id":"wikiquote-c922188a39ccc6981e99d6b5908d8b6ca407d8628000c06932bdbd918d031e9e","text":"Is she not passing fair?","pageTitle":"The Two Gentlemen of Verona","locator":"Silvia, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3193540#Act_IV","rightsEvidence":{}},{"id":"wikiquote-cd638dec72890baf61f4b0398d911b4f76632dbfc272664ebb3280825bc3fdcc","text":"Come not within the measure of my wrath.","pageTitle":"The Two Gentlemen of Verona","locator":"Valentine, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3193540#Act_V","rightsEvidence":{}},{"id":"wikiquote-882d66e71ba518c9e280b753bc9c956b5b54558f47d7f048c9bc9195f5d6c92c","text":"A cigarette is the perfect type of a perfect pleasure. It is exquisite, and it leaves one unsatisfied. What more can one want?","pageTitle":"Drugs","locator":"Oscar Wilde, The Picture of Dorian Gray (1891).","url":"https://en.wikiquote.org/w/index.php?oldid=3915154#%5B%5BTobacco%5D%5D","rightsEvidence":{}},{"id":"wikiquote-c34974ec64af28b2898c8802ed778a4d406bb32eb994625bfebc288347d42d95","text":"There now is your insular city of the Manhattoes, belted round by wharves as Indian isles by coral reefs—commerce surrounds it with her surf.","pageTitle":"Moby-Dick","locator":"p. 1","url":"https://en.wikiquote.org/w/index.php?oldid=3962897#Loomings_%281%29","rightsEvidence":{}},{"id":"wikiquote-199d51329ce962f620e664a7f4df450db2276f71805fde5dad994fe8d587e803","text":"Circumambulate the city of a dreamy Sabbath afternoon.","pageTitle":"Moby-Dick","locator":"p. 1","url":"https://en.wikiquote.org/w/index.php?oldid=3962897#Loomings_%281%29","rightsEvidence":{}},{"id":"wikiquote-f40f92287c6a22e2805cd28db788ce64325f2607615d4e590ace6621eb204307","text":"Yes, as every one knows, meditation and water are wedded for ever.","pageTitle":"Moby-Dick","locator":"p. 2","url":"https://en.wikiquote.org/w/index.php?oldid=3962897#Loomings_%281%29","rightsEvidence":{}}]
