[{"id":"wikiquote-2d50daf70625496a5235e67a5558d9d52df0f5701fcfdfe4d97c565b9b5664b1","text":"If you tax too high, the revenue will yield nothing.","pageTitle":"Taxation","locator":"Ralph Waldo Emerson, “Compensation,” Essays, First Series (1841, repr. 1847).","url":"https://en.wikiquote.org/w/index.php?oldid=4022903#E_to_H","rightsEvidence":{}},{"id":"wikiquote-ba3191f48233f04b483726a035b367338976ae4763f06171f3a1168bc29ad455","text":"Who ever loved that loved not at first sight?","pageTitle":"Christopher Marlowe","locator":"First Sestiad. The same statement occurs in As You Like It (1600) by William Shakespeare, and a similar one in The Blind Beggar of Alexandria (1596) by George Chapman.","url":"https://en.wikiquote.org/w/index.php?oldid=3915325#%27%27%5B%5Bw%3AHero_and_Leander_%28poem%29%7CHero_and_Leander%5D%5D%27%27_%28published_1598%29","rightsEvidence":{}},{"id":"wikiquote-679992377770c689848cffa543565f247367d6065333f6dd4bb0df5767973e49","text":"I cannot repeat an emotion. No one can, except sentimentalists.","pageTitle":"The Picture of Dorian Gray","locator":"(Dorian).","url":"https://en.wikiquote.org/w/index.php?oldid=3952625#Chapter_9","rightsEvidence":{}},{"id":"wikiquote-83cee844de15d67439d97aad60312e75c778c6d301f9b5b5a2ba5815cb1f6484","text":"You will rejoice to hear that no disaster has accompanied the commencement of an enterprise which you have regarded with such evil forebodings.","pageTitle":"Opening lines","locator":"Frankenstein by Mary Shelley.","url":"https://en.wikiquote.org/w/index.php?oldid=3992418#F","rightsEvidence":{}},{"id":"wikiquote-1176d6c83fc0f09d1499c82104549a89216cccd1bf5a776cfde59c6f337dec46","text":"My father's family name being Pirrip, and my Christian name Philip, my infant tongue could make of both names nothing longer or more explicit than Pip.","pageTitle":"Opening lines","locator":"Great Expectations by Charles Dickens.","url":"https://en.wikiquote.org/w/index.php?oldid=3992418#G","rightsEvidence":{}},{"id":"wikiquote-80b42c4bc1a4e909eaf5240b111f4b7e85052cfa9a900b4b974164d00b169425","text":"There was no possibility of taking a walk that day.","pageTitle":"Opening lines","locator":"Jane Eyre by Charlotte Bronte.","url":"https://en.wikiquote.org/w/index.php?oldid=3992418#J","rightsEvidence":{}},{"id":"wikiquote-d703fd7a8936159378f3f3825ea7ddb19f98529eca00d30431ef8092cc6cc53d","text":"\"Christmas won't be Christmas without any presents,\" grumbled Jo, lying on the rug.","pageTitle":"Opening lines","locator":"Little Women by Louisa May Alcott.","url":"https://en.wikiquote.org/w/index.php?oldid=3992418#L","rightsEvidence":{}},{"id":"wikiquote-0883804966ec30231230499d187139aca4cd2e822724500b173d020295a351fe","text":"Call me Ishmael.","pageTitle":"Opening lines","locator":"Moby-Dick by Herman Melville.","url":"https://en.wikiquote.org/w/index.php?oldid=3992418#M","rightsEvidence":{}},{"id":"wikiquote-8f8d109fe38464216d65ce3d97bbaece37772c2afaf0fcd56c6198de95cccb2b","text":"It is a truth universally acknowledged, that a single man in possession of a good fortune must be in want of a wife.","pageTitle":"Opening lines","locator":"Pride and Prejudice by Jane Austen.","url":"https://en.wikiquote.org/w/index.php?oldid=3992418#P","rightsEvidence":{}},{"id":"wikiquote-8eeb1c38b2330e3fbc6aee06a5daf7ded18fd2b03509b53f8e5ea7ee8c292789","text":"When Mary Lennox was sent to Misselthwaite Manor to live with her uncle everybody said she was the most disagreeable-looking child ever seen.","pageTitle":"Opening lines","locator":"The Secret Garden by Frances Hodgson Burnett.","url":"https://en.wikiquote.org/w/index.php?oldid=3992418#S","rightsEvidence":{}},{"id":"wikiquote-d73e7e3af10d251c0b1d82b4b4cccffa8f958e1b1b5928f7570d1d33368a8ad1","text":"The Time Traveller (for so it will be convenient to speak of him) was expounding a recondite matter to us.","pageTitle":"Opening lines","locator":"The Time Machine, by H. G. Wells.","url":"https://en.wikiquote.org/w/index.php?oldid=3992418#T","rightsEvidence":{}},{"id":"wikiquote-3900b3773cc18532ad6800b642ea64f1b83e25f1babc140c0b0c34dd5d3aead2","text":"When I wrote the following pages, or rather the bulk of them, I lived alone, in the woods, a mile from any neighbor, in a house which I had built myself, on the shore of Walden Pond, in Concord, Massachusetts, and earned my living by the labor of my hands only.","pageTitle":"Walden","locator":"First lines","url":"https://en.wikiquote.org/w/index.php?oldid=3922179#Chapter_1%3A_%27%27Economy%27%27","rightsEvidence":{}},{"id":"wikiquote-1e4a9f1e039ec109efa0f99795160cedd39b744ebb2afd9d9817916ef0269380","text":"Dorothy lived in the midst of the great Kansas prairies, with Uncle Henry, who was a farmer, and Aunt Em, who was the farmer's wife.","pageTitle":"Opening lines","locator":"The Wonderful Wizard of Oz by L. Frank Baum.","url":"https://en.wikiquote.org/w/index.php?oldid=3992418#W","rightsEvidence":{}},{"id":"wikiquote-d9edcdeb5a2903557a0485f62bc35ae2a12f0c288077346e506fa6148cbe7727","text":"I am not only witty in myself, but the cause that wit is in other men.","pageTitle":"Henry IV, Part 2","locator":"Falstaff, scene ii","url":"https://en.wikiquote.org/w/index.php?oldid=3027654#Act_I","rightsEvidence":{}},{"id":"wikiquote-22fa539e14b16307671d566df124b41c0178d3022ac97156bbb71b3285c70dae","text":"If I do, fillip me with a three-man beetle.","pageTitle":"Henry IV, Part 2","locator":"Falstaff, scene ii","url":"https://en.wikiquote.org/w/index.php?oldid=3027654#Act_I","rightsEvidence":{}},{"id":"wikiquote-4bbb43aeb7b132e21795e2a95482e9b47d46b9b25095e866ed8be4bfc88713f5","text":"I’ll tickle your catastrophe.","pageTitle":"Henry IV, Part 2","locator":"Falstaff, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3027654#Act_II","rightsEvidence":{}},{"id":"wikiquote-68ce035659276bb1e63dd3c9692a8b2c3997a3077fdd6e57746634706968524f","text":"Let the end try the man.","pageTitle":"Henry IV, Part 2","locator":"Prince Henry, scene ii","url":"https://en.wikiquote.org/w/index.php?oldid=3027654#Act_II","rightsEvidence":{}},{"id":"wikiquote-98af2c26861542a54485653d24f07e4752758b86b111c3db790b67bcd9fe994c","text":"I beseek you now, aggravate your choler.","pageTitle":"Henry IV, Part 2","locator":"Mistress Quickly, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3027654#Act_II","rightsEvidence":{}},{"id":"wikiquote-4b0ecd7e00426d864787456badb65d7c1f2e4f29f2f04a168b5431573b52dda7","text":"Let that suffice, most forcible Feeble.","pageTitle":"Henry IV, Part 2","locator":"Falstaff, scene ii","url":"https://en.wikiquote.org/w/index.php?oldid=3027654#Act_III","rightsEvidence":{}},{"id":"wikiquote-1a6ed49883a721037baf9e6aa4a194441cb5fceb09336f3c93993440f637df4b","text":"His cares are now all ended.","pageTitle":"Henry IV, Part 2","locator":"Warwick, scene ii","url":"https://en.wikiquote.org/w/index.php?oldid=3027654#Act_V","rightsEvidence":{}},{"id":"wikiquote-8c85b36e4721cda15d684dc5c06e77eccbed0a7b1f0fa9828542970e940576b0","text":"I am your butt, and I abide your shot.","pageTitle":"Henry VI, Part 3","locator":"Richard Plantagenet, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3935781#Act_I","rightsEvidence":{}},{"id":"wikiquote-8d9b91dfe27d449fb4da052b498c091f6d225e739e18218efeb6552546895572","text":"Yet hasty marriage seldom proveth well.","pageTitle":"Henry VI, Part 3","locator":"Richard of Gloucester, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3935781#Act_IV","rightsEvidence":{}},{"id":"wikiquote-119599487f4414201b70a61d11b397216044dfc81a0df086db7dd0cb3ab29bda","text":"How irksome is this music to my heart! When such strings jar, what hope of harmony?","pageTitle":"Henry VI, Part 2","locator":"King Henry, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3226609#Act_II","rightsEvidence":{}},{"id":"wikiquote-af81cb983da9817ea8c0e802e85bef74c57dc0e9e9bde61a4aaa3d81e668319e","text":"Small things make base men proud.","pageTitle":"Henry VI, Part 2","locator":"Suffolk, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3226609#Act_IV","rightsEvidence":{}},{"id":"wikiquote-1f7d36fc65ec723ccbadd8445a9bb1b086656475c4f4e738a475062cfbf48e95","text":"I say it was never merry world in England since gentlemen came up.","pageTitle":"Henry VI, Part 2","locator":"Second rebel, scene ii","url":"https://en.wikiquote.org/w/index.php?oldid=3226609#Act_IV","rightsEvidence":{}},{"id":"wikiquote-ca24e9942aba323176efd7f91525883cf4ddbe1aae2d0d652e99a957f0290e4d","text":"The first thing we do, let's kill all the lawyers.","pageTitle":"Henry VI, Part 2","locator":"Dick the butcher, scene ii","url":"https://en.wikiquote.org/w/index.php?oldid=3226609#Act_IV","rightsEvidence":{}},{"id":"wikiquote-706298a50b96889aeffc3fa85a08adacdd6f87d336c44a392657390019ccc675","text":"And Adam was a gardener.","pageTitle":"Henry VI, Part 2","locator":"Cade, scene ii","url":"https://en.wikiquote.org/w/index.php?oldid=3226609#Act_IV","rightsEvidence":{}},{"id":"wikiquote-6fc9a475e14743cb45787b570fe902dea3e0db9ca5c42f0e872d83df6758d532","text":"Can we outrun the heavens?","pageTitle":"Henry VI, Part 2","locator":"King Henry, scene ii","url":"https://en.wikiquote.org/w/index.php?oldid=3226609#Act_V","rightsEvidence":{}},{"id":"wikiquote-cdb439577a973051b1be511379b676a2d59b57183b38e84aa994a1184e9125c4","text":"God save the mark!","pageTitle":"Henry IV, Part 1","locator":"Hotspur, scene iii","url":"https://en.wikiquote.org/w/index.php?oldid=3027653#Act_I","rightsEvidence":{}},{"id":"wikiquote-ec362f88a5bbb808707c0b917e96109e7e09d847037cd22eaa257ef81b2b2e8d","text":"If the rascal have not given me medicines to make me love him, I'll be hanged.","pageTitle":"Henry IV, Part 1","locator":"Falstaff, scene ii","url":"https://en.wikiquote.org/w/index.php?oldid=3027653#Act_II","rightsEvidence":{}},{"id":"wikiquote-3e7634033b88b754acbccd8bc1a4b30c4ef064afa81beac65d0a5f51f16b4488","text":"I could brain him with his lady’s fan.","pageTitle":"Henry IV, Part 1","locator":"Hotspur, scene iii","url":"https://en.wikiquote.org/w/index.php?oldid=3027653#Act_II","rightsEvidence":{}},{"id":"wikiquote-f5be3c89a6e22f9014eadb1a73787763820d8664528dd54aa09e45d409438a09","text":"I am a Jew else, an Ebrew Jew.","pageTitle":"Henry IV, Part 1","locator":"Falstaff, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3027653#Act_II","rightsEvidence":{}},{"id":"wikiquote-33f2071a35fa5259341cd466c6e3c8fef17e46ddf531492df1fdca391f9ead21","text":"I was now a coward on instinct.","pageTitle":"Henry IV, Part 1","locator":"Falstaff, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3027653#Act_II","rightsEvidence":{}},{"id":"wikiquote-422df0af7805d85f7603228a9dad6338b07cf59213999d746bb3c012fc9442a4","text":"I must speak in passion, and I will do it in King Cambyses’ vein.","pageTitle":"Henry IV, Part 1","locator":"Falstaff, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3027653#Act_II","rightsEvidence":{}},{"id":"wikiquote-dd8d0166e85642fb6bf87f54e231b13bfe19373d00e62b5b389bcc67ea511914","text":"Banish plump Jack, and banish all the world.","pageTitle":"Henry IV, Part 1","locator":"Falstaff, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3027653#Act_II","rightsEvidence":{}},{"id":"wikiquote-c4782ba4d579c472c9c8c19e86f15b7023e3ea87b1075e772af34e649a7491ae","text":"Play out the play.","pageTitle":"Henry IV, Part 1","locator":"Falstaff, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3027653#Act_II","rightsEvidence":{}},{"id":"wikiquote-8d134cde211574404ac2ab9d779a2c52a4495b0068be092970694910871d009a","text":"I am not in the roll of common men.","pageTitle":"Henry IV, Part 1","locator":"Glendower, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3027653#Act_III","rightsEvidence":{}},{"id":"wikiquote-4850e873d83c100e967201282c83e63f90b75e472449258a0d00d477e2d43bf9","text":"For nothing can seem foul to those that win.","pageTitle":"Henry IV, Part 1","locator":"King Henry, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3027653#Act_V","rightsEvidence":{}},{"id":"wikiquote-e794897fe9fb85a2f0031bdb004d258591cf28c07292567a1cf0e511e5404210","text":"Adam and Eve, according to the fable, wore the bower before other clothes. Man wanted a home, a place of warmth, or comfort, first of physical warmth, then the warmth of the affections.","pageTitle":"Adam and Eve","locator":"Henry David Thoreau, Walden (1854).","url":"https://en.wikiquote.org/w/index.php?oldid=3890827#Quotes","rightsEvidence":{}},{"id":"wikiquote-f3495a75ffe06022cdda338be08aed53a5b6e085b2f6652214f63918dbc167a5","text":"Sweet mercy is nobility's true badge.","pageTitle":"Titus Andronicus","locator":"Tamora, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3561226#Act_I","rightsEvidence":{}},{"id":"wikiquote-3f1b4cde017cf867147e4c09719e2a96b19039f8fe68695be67631b627d29605","text":"I dare do all that may become a man; Who dares do more is none.","pageTitle":"V for Vendetta (film)","locator":"William Shakespeare, in Macbeth 1.7.47-48","url":"https://en.wikiquote.org/w/index.php?oldid=3996229#Quoted_from_other_sources","rightsEvidence":{}},{"id":"wikiquote-9ba8c57896d43952292e16505e607cf126a3f88fdc4c6a47d95468929e21ee62","text":"He could hear nothing: the night was perfectly silent. He listened again: perfectly silent. He felt that he was alone.","pageTitle":"Loneliness","locator":"James Joyce in Dubliners (1914), \"A Painful Case\".","url":"https://en.wikiquote.org/w/index.php?oldid=3957278#Quotes","rightsEvidence":{}},{"id":"wikiquote-0abe0f48cab14c84779cec7a53b9a8677714c70bcbe3dd2fa0d52829ac7e2679","text":"A plague upon it when thieves cannot be true one to another!","pageTitle":"Theft","locator":"William Shakespeare, Henry IV, Part I (c. 1597), Act II, scene 2, line 29.","url":"https://en.wikiquote.org/w/index.php?oldid=3915497#Q-Z","rightsEvidence":{}},{"id":"wikiquote-0795a2716aadb54a4249680bde6a23f0e9019080d18a58b5ba2f0d714d103fa8","text":"I know a lady in Venice would have walked barefoot to Palestine for a touch of his nether lip.","pageTitle":"Palestine (region)","locator":"William Shakespeare, Othello, act 4, sc. 3 (Emilia)","url":"https://en.wikiquote.org/w/index.php?oldid=4018477#S","rightsEvidence":{}},{"id":"wikiquote-cfa320918b775d3e66b4eabb7908274d777ca0cfe19244f990e34143f48ffca6","text":"You a captain? You slave, for what? For tearing a poor whore’s ruff in a bawdy-house?","pageTitle":"Prostitution","locator":"Shakespeare, Henry IV, Part 2 (c. 1599) act 2, sc. 4 (Doll)","url":"https://en.wikiquote.org/w/index.php?oldid=3957317#S","rightsEvidence":{}},{"id":"wikiquote-a7fe8bfef80b92e5bed87b3e03b36747d9bf23cc39e03c68bff0300082fad717","text":"Come, I am for no more bawdy houses: shall’s go hear the vestals sing?","pageTitle":"Prostitution","locator":"Shakespeare, Pericles, Prince of Tyre (1609) act 4, sc. 5 (2 Gentleman)","url":"https://en.wikiquote.org/w/index.php?oldid=3957317#S","rightsEvidence":{}},{"id":"wikiquote-491184da1adfd53960dc3b18542e57a8d969b1d0313f28deafef9efff014d9a5","text":"Grace me no grace, nor uncle me no uncle.","pageTitle":"X me no Xs","locator":"William Shakespeare, Richard II. (1595), act ii, scene 3.","url":"https://en.wikiquote.org/w/index.php?oldid=2226376#Quotes","rightsEvidence":{}},{"id":"wikiquote-44ab72cdafa9cd78cd6d597adce9ca13d3132fed95ca93013b17fc66b94d8cc8","text":"Come, headsman, off with his head.","pageTitle":"Capital punishment","locator":"William Shakespeare, All's Well That Ends Well (c. 1598–1608), act iv, sc. 3 (1 Soldier)","url":"https://en.wikiquote.org/w/index.php?oldid=3990056#S","rightsEvidence":{}},{"id":"wikiquote-2f51e38b03386f7b1b536d4eb76d9545dd3289456230d0a98ca03d01ff5b60da","text":"O, burn her, burn her! Hanging is too good.","pageTitle":"Capital punishment","locator":"William Shakespeare, Henry VI, Part 1 (1591), act v, sc. 4 (Shepherd)","url":"https://en.wikiquote.org/w/index.php?oldid=3990056#S","rightsEvidence":{}},{"id":"wikiquote-474c295f4f5eba4dd8849e77767da45c1b6d676457efe642823a372be6c90eda","text":"Hush! Don't say that. You have done enough evil in your life. My God! Don't you see that accursed thing leering at us?","pageTitle":"Fictional last words in literature","locator":"Who: Basil Hallward Source: The Picture of Dorian Gray","url":"https://en.wikiquote.org/w/index.php?oldid=3948376#%27%27The_Lord_of_the_Rings%27%27","rightsEvidence":{}},{"id":"wikiquote-10aab373bcd9502f124e3f68220934f3ad8dfa1fdc0667d8f594230e1ec17d11","text":"All men's faces are true, whatsome'er their hands are.","pageTitle":"Physiognomy","locator":"William Shakespeare, Antony and Cleopatra (1600s), Act II, scene 6, line 102.","url":"https://en.wikiquote.org/w/index.php?oldid=3871068#Quotes","rightsEvidence":{}},{"id":"wikiquote-d25bde4f18749c54a86576d847ece3b816d6d90cccc7e50b0b304609034214fc","text":"Sin is a thing that writes itself across a man's face. It cannot be concealed. People talk sometimes of secret vices. There are no such things. If a wretched man has a vice, it shows itself in the lines of his mouth, the droop of his eyelids, the moulding of his hands even.","pageTitle":"Physiognomy","locator":"Oscar Wilde, The Picture of Dorian Gray, Ch. 12 (1890)","url":"https://en.wikiquote.org/w/index.php?oldid=3871068#Quotes","rightsEvidence":{}},{"id":"wikiquote-a15f99a9ee4deced67c02975ff92f2428c9facaf18f30b7fb932c20382b14cf1","text":"Past and to come seems best; things present, worst.","pageTitle":"Present","locator":"William Shakespeare, Henry IV, Part 2, Act I, sc. iii, ln. 108.","url":"https://en.wikiquote.org/w/index.php?oldid=3935204#S","rightsEvidence":{}},{"id":"wikiquote-3292a5358da6c5479b94c8d63f2fe184fd67945db5bfed7b76a27903e1097278","text":"I do not like the fashion of your garments. You’ll say they are Persian; but let them be changed.","pageTitle":"Iran","locator":"Shakespeare, King Lear (c. 1603) act 3, sc. 6 (Lear to 'Poor Tom')","url":"https://en.wikiquote.org/w/index.php?oldid=3979599#S","rightsEvidence":{}},{"id":"wikiquote-6eff9f86b0448b2221ca29abaf4cc4240c00f6234c1a8c14d0cf90aea2a5a59b","text":"The truest of all men was the Man of Sorrows, and the truest of all books is Solomon's, and Ecclesiastes is the fine hammered steel of woe. \"All is vanity.\" ALL.","pageTitle":"Ecclesiastes","locator":"Herman Melville, Moby-Dick (ch. 96) (1851)","url":"https://en.wikiquote.org/w/index.php?oldid=3785940#About","rightsEvidence":{}},{"id":"wikiquote-b448dc8fa73b1cc643530c0dc434ff7934b909f7aa25694710c823dbc4962d2e","text":"He will steal, sir, an egg out of a cloister: for rapes and ravishments he parallels Nessus.","pageTitle":"Rape","locator":"William Shakespeare, All's Well That Ends Well, IV, iii (Parolles)","url":"https://en.wikiquote.org/w/index.php?oldid=4003760#S","rightsEvidence":{}},{"id":"wikiquote-a9091699a73b6a9635db3ee0849c37abb66fb92af04d5a8a08c4fae5376f57da","text":"There is always something ridiculous about the emotions of people whom one has ceased to love.","pageTitle":"Emotions","locator":"Oscar Wilde, in The Picture of Dorian Gray (1890), Ch. 7","url":"https://en.wikiquote.org/w/index.php?oldid=3808597#Quotes","rightsEvidence":{}},{"id":"wikiquote-99be201118cf4d9300d7cd9adc46c83aaa623d25de7bd445517e691940790f65","text":"Make you a sword of me?","pageTitle":"Coriolanus","locator":"Marcius, scene vi","url":"https://en.wikiquote.org/w/index.php?oldid=3983704#Act_I","rightsEvidence":{}},{"id":"wikiquote-0cd42793fe64c681c034ee34fe7e4043d25486b9bc43bae015b9d2608bc99bf1","text":"Nature teaches beasts to know their friends.","pageTitle":"Coriolanus","locator":"Sicinius, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3983704#Act_II","rightsEvidence":{}},{"id":"wikiquote-4535a986f90da86d7b032be556f8cb40d488e3d4d6d6dfa8f3474bb855e2ff57","text":"Enough, with over-measure.","pageTitle":"Coriolanus","locator":"Brutus, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3983704#Act_III","rightsEvidence":{}},{"id":"wikiquote-c9707022b2948a2efc28dd546916b86e86e943a774f357de555ea1a34d373c20","text":"What is the city but the people?","pageTitle":"Coriolanus","locator":"Sicinius, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3983704#Act_III","rightsEvidence":{}},{"id":"wikiquote-dd9873c4bc521c12a6e2e967becbfe8caa6f6f538dc388891140d03668622ce0","text":"As chaste as unsunn'd snow.","pageTitle":"Cymbeline","locator":"Posthumus, scene v","url":"https://en.wikiquote.org/w/index.php?oldid=3027607#Act_II","rightsEvidence":{}},{"id":"wikiquote-851bb7ce826f58d1e0832ade38b7b3e862fc3f5995975a39312a7ab89ec468e5","text":"I have not slept one wink.","pageTitle":"Cymbeline","locator":"Pisanio, scene iv","url":"https://en.wikiquote.org/w/index.php?oldid=3027607#Act_III","rightsEvidence":{}},{"id":"wikiquote-c09e8428428a9ab528cfd714394ef51213242f3d66c75929be49197116a63713","text":"Your wit’s too hot, it speeds too fast, ’twill tire.","pageTitle":"Love's Labour's Lost","locator":"Biron, l. 119","url":"https://en.wikiquote.org/w/index.php?oldid=3937311#Scene_i","rightsEvidence":{}}]
