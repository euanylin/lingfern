[{"id":"wikiquote-211c53726b268040ef496def9022c4581b9143a5acc2184d1b6e03d92a107dda","text":"He jests at scars that never felt a wound.","pageTitle":"Romeo and Juliet","locator":"Romeo, l. 1","url":"https://en.wikiquote.org/w/index.php?oldid=3961930#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-17a10ccc3f0786fb93a77d9ba7a50066372e9a61cdb31671d69cc564ee13ee8f","text":"I am the very pink of courtesy.","pageTitle":"Romeo and Juliet","locator":"Mercutio, l. 54","url":"https://en.wikiquote.org/w/index.php?oldid=3961930#Scene_iv","rightsEvidence":{}},{"id":"wikiquote-0e6f98821d90d099ebfd7fa9264648a9eaa60ce1971ed0989a8125eb0a741191","text":"O, I am fortune's fool!","pageTitle":"Romeo and Juliet","locator":"Romeo, l. 132","url":"https://en.wikiquote.org/w/index.php?oldid=3961930#Scene_i","rightsEvidence":{}},{"id":"wikiquote-aaeaca2bcb3a12063820a4f2fdbd2a035fe6e66144de165dde94f431360ebba8","text":"Villain and he be many miles asunder.","pageTitle":"Romeo and Juliet","locator":"Juliet, l. 81","url":"https://en.wikiquote.org/w/index.php?oldid=3961930#Scene_v","rightsEvidence":{}},{"id":"wikiquote-92694ebd29717a891d16271184e8a0264d7cce46359743abcff58625f751c788","text":"And her immortal part with angels lives.","pageTitle":"Romeo and Juliet","locator":"Balthasar, l. 19","url":"https://en.wikiquote.org/w/index.php?oldid=3961930#Scene_i","rightsEvidence":{}},{"id":"wikiquote-1da5c63ee4339d6a4ae99b0d8414b3a8a740bd5ddc938b8c3a9534207d5e0022","text":"Being holiday, the beggar's shop is shut.","pageTitle":"Romeo and Juliet","locator":"Romeo, l. 56","url":"https://en.wikiquote.org/w/index.php?oldid=3961930#Scene_i","rightsEvidence":{}},{"id":"wikiquote-504a4087f3a8838fa00446e0948ff5666ef6c85990fc359d3544ec6c0f70601c","text":"You come most carefully upon your hour.","pageTitle":"Hamlet","locator":"Francisco, line 6","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_i","rightsEvidence":{}},{"id":"wikiquote-657ec7b5f60a9811e6f7c8d638926906a1d8cc32a7842a81aeda6dbcdaeb9347","text":"And I am sick at heart.","pageTitle":"Hamlet","locator":"Francisco","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_i","rightsEvidence":{}},{"id":"wikiquote-624d98eb342f76d429c8e39ddcbed15db5dd2cd3d3812a7f2217b96d4f5047a5","text":"Not a mouse stirring.","pageTitle":"Hamlet","locator":"Francisco, line 10","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_i","rightsEvidence":{}},{"id":"wikiquote-9ce063bb457c67f075c210807157ed79a4c02002da6d22a93c348585aa1ab39f","text":"It harrows me with fear and wonder.","pageTitle":"Hamlet","locator":"Horatio","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_i","rightsEvidence":{}},{"id":"wikiquote-58cc52c5cf29079a1811825810aa5f9f48ded5b5512502ff6878f97eeb95cd17","text":"And our vain blows malicious mockery.","pageTitle":"Hamlet","locator":"Marcellus","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_i","rightsEvidence":{}},{"id":"wikiquote-48ff9eb24d507d1b360f8c9511c1b6db8ea8954f228702115e9713f07550fc5f","text":"In my mind's eye, Horatio.","pageTitle":"Hamlet","locator":"Hamlet","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-c11e8a2d9bed327593fc0b8c83bee148f1d254addfc24672ca831bd07cef6c30","text":"A countenance more in sorrow than in anger.","pageTitle":"Hamlet","locator":"Horatio, line 231","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-52266ab43edb48b4e737c9f60ecd5776bb06f5ef09f0f6edc872f0b65e3d8069","text":"Give it an understanding, but no tongue.","pageTitle":"Hamlet","locator":"Hamlet","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-1894831cf2ebcbc98491eed7090ffa0f115062500e6be1f5dcc8135ab6b42533","text":"Something is rotten in the state of Denmark.","pageTitle":"Hamlet","locator":"Marcellus, line 90","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_iv","rightsEvidence":{}},{"id":"wikiquote-9ed502acd666b2aa068085f8ac4e5567d4bb005d6f95907a12b29ba0fc3cb5d1","text":"I could be bounded in a nutshell, and count myself a king of infinite space, were it not that I have bad dreams.","pageTitle":"Hamlet","locator":"Hamlet","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-89d4d77240242890d46277b5034b05434a342a76dd31889ceb00be63450f4ef6","text":"Which dreams, indeed, are ambition; for the very substance of the ambitious is merely the shadow of a dream.","pageTitle":"Hamlet","locator":"Guildenstern","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-297160ba057899448bc166508ee2ed6168e44df088f8fbe376d3ec14ca731cb8","text":"Use every man after his desert, and who should 'scape whipping?","pageTitle":"Hamlet","locator":"Hamlet","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-fa2f20137916a69fba8435a0e7f84c940d8b4602660f8a09a491efe651813977","text":"Rich gifts wax poor when givers prove unkind.","pageTitle":"Hamlet","locator":"Ophelia","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_i","rightsEvidence":{}},{"id":"wikiquote-08b392654175d665dc0aae171c3bd1a93d6cd47e0292106a5ba9dcceb796f407","text":"Go, bid the soldiers shoot.","pageTitle":"Hamlet","locator":"Fortinbras","url":"https://en.wikiquote.org/w/index.php?oldid=3952082#Scene_ii","rightsEvidence":{}},{"id":"wikiquote-b035a0d2c5b77943691eee8a1dfd648c6ec23c9f5f8c4cc1c55b52bf009f1255","text":"So foul and fair a day I have not seen.","pageTitle":"Macbeth","locator":"Macbeth, Scene III","url":"https://en.wikiquote.org/w/index.php?oldid=4022895#Act_I","rightsEvidence":{}},{"id":"wikiquote-dfd00facf7b048534461d44afbd96a88c0066e0d70f9569ddadc7df567b19acd","text":"What a haste looks through his eyes!","pageTitle":"Macbeth","locator":"Lennox","url":"https://en.wikiquote.org/w/index.php?oldid=4022895#Act_I","rightsEvidence":{}},{"id":"wikiquote-3d6a994e6d6d1b4feb2014384b0b38b59350caf83b725bf910b19b802b1ce927","text":"The moon is down; I have not heard the clock.","pageTitle":"Macbeth","locator":"Fleance, Scene I","url":"https://en.wikiquote.org/w/index.php?oldid=4022895#Act_II","rightsEvidence":{}},{"id":"wikiquote-cf9fbb35ac4fd8af7c791210e9be47567758ab6313ae5342d2a7c0f8bbe2246e","text":"Things bad begun make strong themselves by ill.","pageTitle":"Macbeth","locator":"Macbeth, Scene II","url":"https://en.wikiquote.org/w/index.php?oldid=4022895#Act_III","rightsEvidence":{}},{"id":"wikiquote-d08e925b0f09393169bac9a6c84eff03ae19e0f8313125fb852d683d4007f71c","text":"You lack the season of all natures, sleep.","pageTitle":"Macbeth","locator":"Lady Macbeth, Scene IV","url":"https://en.wikiquote.org/w/index.php?oldid=4022895#Act_III","rightsEvidence":{}},{"id":"wikiquote-007190c25df668461df14d438e2d1837b7c8f985b1bbb8a0939f5589abb5905a","text":"Here's the smell of the blood still: all the perfumes of Arabia will not sweeten this little hand. Oh, oh, oh!","pageTitle":"Macbeth","locator":"Lady Macbeth, Scene I","url":"https://en.wikiquote.org/w/index.php?oldid=4022895#Act_V","rightsEvidence":{}},{"id":"wikiquote-4b98c67b2d05def0f015d18e71034e0fcb4569b246da1097d73580568e421b69","text":"What's done cannot be undone.","pageTitle":"Macbeth","locator":"Lady Macbeth, Scene I","url":"https://en.wikiquote.org/w/index.php?oldid=4022895#Act_V","rightsEvidence":{}},{"id":"wikiquote-657c84f94e67bb30fa56ca5a3ee9b524fa3c52fba84e93c1e1856022e017693a","text":"I prithee, be my god.","pageTitle":"The Tempest","locator":"Caliban, scene ii","url":"https://en.wikiquote.org/w/index.php?oldid=3956657#Act_II","rightsEvidence":{}},{"id":"wikiquote-77abfc0114a16c57bcf858b851d5197265a968c48b9ac79f3526ef440450a48e","text":"With foreheads villainous low.","pageTitle":"The Tempest","locator":"Caliban, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3956657#Act_IV","rightsEvidence":{}},{"id":"wikiquote-a76b9a0141d3c73a0793d95d7d8d93bf36fba58dbfa0fb76c5960e987bb26f77","text":"In rage, deaf as the sea, hasty as fire.","pageTitle":"Richard II (play)","locator":"King Richard, Scene I","url":"https://en.wikiquote.org/w/index.php?oldid=3027659#Act_I","rightsEvidence":{}},{"id":"wikiquote-4942d269217501b50d032edae901f4d2566b4877823b453b47f75993870e6a69","text":"The daintiest last, to make the end most sweet.","pageTitle":"Richard II (play)","locator":"Bolingbroke, Scene III","url":"https://en.wikiquote.org/w/index.php?oldid=3027659#Act_I","rightsEvidence":{}},{"id":"wikiquote-2a056c0a5fa569bee967ebc6c99310006fb3a421581ec5cff941cf16b05627f3","text":"In following him, I follow but myself.","pageTitle":"Othello","locator":"Iago, scene I","url":"https://en.wikiquote.org/w/index.php?oldid=3883098#Act_I","rightsEvidence":{}},{"id":"wikiquote-4055339775aaa96cd4943d917614babb2d90f092bdc0ac25bae9c83d258cbbaf","text":"Keep up your bright swords, for the dew will rust them.","pageTitle":"Othello","locator":"Othello, scene II","url":"https://en.wikiquote.org/w/index.php?oldid=3883098#Act_I","rightsEvidence":{}},{"id":"wikiquote-16b918f706949219393aa6d5a100963fb75b8f68313acd2eaddc31d42f78bd8f","text":"Thus do I ever make my fool my purse.","pageTitle":"Othello","locator":"Iago, scene III","url":"https://en.wikiquote.org/w/index.php?oldid=3883098#Act_I","rightsEvidence":{}},{"id":"wikiquote-42fa4b0a2d8555618e39188c38ab621dea831a5e9a0cfec0b4b75f5ac38cc2b2","text":"Knavery's plain face is never seen till us'd.","pageTitle":"Othello","locator":"Iago, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3883098#Act_II","rightsEvidence":{}},{"id":"wikiquote-335770a8217e06d92bab94840fbb5b95d99cf5998a87e24f0c55961321326c34","text":"Then put up your pipes in your bag, for I'll away. Go, vanish into air, away!","pageTitle":"Othello","locator":"Clown, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3883098#Act_III","rightsEvidence":{}},{"id":"wikiquote-c5da6c7846d9e7ed12699d398dbcf4bbbd365de83992ffb6678c155540821b37","text":"O damn'd Iago! O inhuman dog!","pageTitle":"Othello","locator":"Roderigo, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3883098#Act_V","rightsEvidence":{}},{"id":"wikiquote-390d9081134f7c8581b3875fae14798c1eca4f76fb24a3b2775dd80bec38ff41","text":"Come not between the dragon and his wrath.","pageTitle":"King Lear","locator":"Lear, Scene I","url":"https://en.wikiquote.org/w/index.php?oldid=3952631#Act_I","rightsEvidence":{}},{"id":"wikiquote-dca888140a06b85624cf2a17c981beb0bf0be58034c0c05e6cea030e1b661ccc","text":"Now, gods, stand up for bastards!","pageTitle":"King Lear","locator":"Edmund, Scene II","url":"https://en.wikiquote.org/w/index.php?oldid=3952631#Act_I","rightsEvidence":{}},{"id":"wikiquote-4ecd8c5630894dff415924436d6a8bf3295d87df8bd16c8fd153690d627ecf7e","text":"Striving to better, oft we mar what's well.","pageTitle":"King Lear","locator":"Albany, Scene IV","url":"https://en.wikiquote.org/w/index.php?oldid=3952631#Act_I","rightsEvidence":{}},{"id":"wikiquote-da6a102cad63e1ce4e3a1a2324c4ed0a2888c447b4ee2f81066bc2bcb4bd4d5b","text":"Cry you mercy, I took you for a joint-stool.","pageTitle":"King Lear","locator":"Fool, Scene VI","url":"https://en.wikiquote.org/w/index.php?oldid=3952631#Act_III","rightsEvidence":{}},{"id":"wikiquote-323ce16c1b457ea7e7513a8faf040c37a52a5b54f702ea9f4a38c1a80496feae","text":"Speak, hands, for me!","pageTitle":"Julius Caesar (play)","locator":"Casca, scene i","url":"https://en.wikiquote.org/w/index.php?oldid=3854633#Act_III","rightsEvidence":{}},{"id":"wikiquote-566b26436f688c75705adfd3b7a20336cace3cbe93092e6175a5319e32e35267","text":"If you have tears, prepare to shed them now.","pageTitle":"Julius Caesar (play)","locator":"Antony, scene ii","url":"https://en.wikiquote.org/w/index.php?oldid=3854633#Act_III","rightsEvidence":{}},{"id":"wikiquote-1881ca6d8b4b2e347a6576b842004265035b2ffda5c658a89792b8ba6492b1e0","text":"I am Cinna the poet, I am Cinna the poet.","pageTitle":"Julius Caesar (play)","locator":"Cinna the Poet, scene iii","url":"https://en.wikiquote.org/w/index.php?oldid=3854633#Act_III","rightsEvidence":{}},{"id":"wikiquote-5527b673ef7be18a378006ad54c2e65d077b89513aba56013216b31a0b064db5","text":"Feelings! I have no time for them, no chance of them. I pass my whole life, miss, in turning an immense pecuniary Mangle.","pageTitle":"A Tale of Two Cities","locator":"Jarvis Lorry","url":"https://en.wikiquote.org/w/index.php?oldid=3945673#Chapter_IV_-_The_Preparation","rightsEvidence":{}},{"id":"wikiquote-573869e05e227ae37adc647ab4c8688b42fec27b07970ee78cef927e8981a0e9","text":"It is a far, far better thing that I do, than I have ever done; it is a far, far better rest that I go to than I have ever known.","pageTitle":"A Tale of Two Cities","locator":"Book III - The Track of a Storm / Chapter XV - The Footsteps Die Out For Ever","url":"https://en.wikiquote.org/w/index.php?oldid=3945673#Chapter_XV_-_The_Footsteps_Die_Out_For_Ever","rightsEvidence":{}},{"id":"wikiquote-230a19e4dbd6c371ad6bcaa5eabb45673cdda5442c665e116adf56ad7fb48b40","text":"Give me to drink mandragora.","pageTitle":"Antony and Cleopatra","locator":"Cleopatra, scene v","url":"https://en.wikiquote.org/w/index.php?oldid=4017922#Act_I","rightsEvidence":{}},{"id":"wikiquote-58617d68932a946aac061d3e762cc6a29283b80dcce29841fa3634903a00971f","text":"I will praise any man that will praise me","pageTitle":"Antony and Cleopatra","locator":"Enobarbus, scene vi","url":"https://en.wikiquote.org/w/index.php?oldid=4017922#Act_II","rightsEvidence":{}},{"id":"wikiquote-0c206847c9e22c4687ad416a0db28af0e0f02b24213da4ff00f6affcc70395b7","text":"Observe how Antony becomes his flaw","pageTitle":"Antony and Cleopatra","locator":"Octavius Caesar, scene xii","url":"https://en.wikiquote.org/w/index.php?oldid=4017922#Act_III","rightsEvidence":{}},{"id":"wikiquote-8ff0ef9de2ecc6098f2c0b2c7b048a3c4093ce6e891dddaeeb5d0ab790ed1c80","text":"Mine honesty and I begin to square.","pageTitle":"Antony and Cleopatra","locator":"Enorbarbus, scene xiii","url":"https://en.wikiquote.org/w/index.php?oldid=4017922#Act_III","rightsEvidence":{}},{"id":"wikiquote-ace140c90029b38ae65d212221a8770064cb2871e5acec6680716000a79faeb2","text":"You were half blasted ere I knew you","pageTitle":"Antony and Cleopatra","locator":"Antony, scene xiii","url":"https://en.wikiquote.org/w/index.php?oldid=4017922#Act_III","rightsEvidence":{}},{"id":"wikiquote-ca79d241a097a4f2446b89084aa0368148e418c736a2300d3038cebee3713eb8","text":"You have been a boggler ever.","pageTitle":"Antony and Cleopatra","locator":"Antony, scene xiii","url":"https://en.wikiquote.org/w/index.php?oldid=4017922#Act_III","rightsEvidence":{}},{"id":"wikiquote-62c8af8190af3b564bcdda940ccb88aa05839e16e74e2120ba54267194887886","text":"The time of universal peace is near.","pageTitle":"Antony and Cleopatra","locator":"Octavius Caesar, scene vi","url":"https://en.wikiquote.org/w/index.php?oldid=4017922#Act_IV","rightsEvidence":{}},{"id":"wikiquote-145aa9fd240808449c53d4d071b68f4c6cfdbef1a2cc16e61f93fb60e2d5525a","text":"The shirt of Nessus is upon me.","pageTitle":"Antony and Cleopatra","locator":"Antony, scene xii","url":"https://en.wikiquote.org/w/index.php?oldid=4017922#Act_IV","rightsEvidence":{}},{"id":"wikiquote-e1bfc2edd3e9195d8595ece838550b27e41d006062ffdfd0030c6e659883150f","text":"Well, I do not mind telling you I have been at work upon this geometry of Four Dimensions for some time. Some of my results are curious. For instance, here is a portrait of a man at eight years old, another at fifteen, another at seventeen, another at twenty-three, and so on. All these are evidently sections, as it were, Three-Dimensional representations of his Four-Dimensioned being, which is a fixed and unalterable thing.","pageTitle":"The Time Machine","locator":"Chapter 1","url":"https://en.wikiquote.org/w/index.php?oldid=3778033#Quotes","rightsEvidence":{}},{"id":"wikiquote-be9f854d4b673d0f51d234f837a8b534a4d2bc68d1ee934f0b61f7be28e8d64c","text":"Strength is the outcome of need; security sets a premium on feebleness.","pageTitle":"The Time Machine","locator":"Chapter 4","url":"https://en.wikiquote.org/w/index.php?oldid=3778033#Quotes","rightsEvidence":{}},{"id":"wikiquote-c65b21dbb8f2602e3b0f76b7c90ff0dc155f161f706fc48e5e4b089830096f2a","text":"Very simple was my explanation, and plausible enough—as most wrong theories are!","pageTitle":"The Time Machine","locator":"Chapter 4","url":"https://en.wikiquote.org/w/index.php?oldid=3778033#Quotes","rightsEvidence":{}},{"id":"wikiquote-e8059626cc6df547bfee1212be813e524463f1a799e2f1e2951a53999fda8365","text":"I was too restless to watch long; I am too Occidental for a long vigil. I could work at a problem for years, but to wait inactive for twenty-four hours—that is another matter.","pageTitle":"The Time Machine","locator":"Chapter 5","url":"https://en.wikiquote.org/w/index.php?oldid=3778033#Quotes","rightsEvidence":{}},{"id":"wikiquote-6de7f6fd0846e9b818067a29b0455e876451cdcbf248a0b9551e3812e7d614b1","text":"Looking at these stars suddenly dwarfed my own troubles and all the gravities of terrestrial life. I thought of their unfathomable distance, and the slow inevitable drift of their movements out of the unknown past into the unknown future.","pageTitle":"The Time Machine","locator":"Chapter 7","url":"https://en.wikiquote.org/w/index.php?oldid=3778033#Quotes","rightsEvidence":{}},{"id":"wikiquote-97d7bee30399f07b39a8f8f04044375d6dccf3ba4cfd0cccd455fab6840da87e","text":"He, I know—for the question had been discussed among us long before the Time Machine was made—thought but cheerlessly of the Advancement of Mankind, and saw in the growing pile of civilisation only a foolish heaping that must inevitably fall back upon and destroy its makers in the end. If that is so, it remains for us to live as though it were not so. But to me the future is still black and blank—is a vast ignorance, lit at a few casual places by the memory of his story. And I have by me, for my comfort, two strange white flowers—shrivelled now, and brown and flat and brittle—to witness that even when mind and strength had gone, gratitude and a mutual tenderness still lived on in the heart of man.","pageTitle":"The Time Machine","locator":"Epilogue","url":"https://en.wikiquote.org/w/index.php?oldid=3778033#Quotes","rightsEvidence":{}},{"id":"wikiquote-1dc04b2c74820b06f77b4d77edd354f37a80d22ec7352a83cea89050e39138ef","text":"Curiouser and curiouser!","pageTitle":"Alice's Adventures in Wonderland","locator":"Alice","url":"https://en.wikiquote.org/w/index.php?oldid=3952630#%5B%5Bs%3AAlice%27s_Adventures_in_Wonderland_%281866%29%2FChapter_2%7CChapter_II.%26nbsp%3B_The_Pool_of_Tears.%5D%5D","rightsEvidence":{}},{"id":"wikiquote-7ad06cd0582c5689d6feb6abbfd8871e404624c4fae8f7481e32e51262996593","text":"They're dreadfully fond of beheading people here; the great wonder is, that there's any one left alive!","pageTitle":"Alice's Adventures in Wonderland","locator":"Alice","url":"https://en.wikiquote.org/w/index.php?oldid=3952630#%5B%5Bs%3AAlice%27s_Adventures_in_Wonderland_%281866%29%2FChapter_8%7CChapter_VIII.%26nbsp%3B_The_Queen%27s_Croquet-Ground.%5D%5D","rightsEvidence":{}},{"id":"wikiquote-2d04af0eb1fce4c18120f8d53fc6b223aaddd34ffe51f04b8260d1e50606c2d0","text":"Everything's got a moral, if only you can find it.","pageTitle":"Alice's Adventures in Wonderland","locator":"The Duchess","url":"https://en.wikiquote.org/w/index.php?oldid=3952630#%5B%5Bs%3AAlice%27s_Adventures_in_Wonderland_%281866%29%2FChapter_9%7CChapter_IX.%26nbsp%3B_The_Mock_Turtle%27s_Story.%5D%5D","rightsEvidence":{}},{"id":"wikiquote-2f5feeab1cd9927abb5dd03945b28ffaad5eead2336b1d19cbc56a881b8e5d4e","text":"She is a selfish, hypocritical woman, and I have no opinion of her.","pageTitle":"Pride and Prejudice","locator":"Ch. 2, Mrs. Bennet of Mrs. Long","url":"https://en.wikiquote.org/w/index.php?oldid=3940795#Chapters_1-10","rightsEvidence":{}}]
