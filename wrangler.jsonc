{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lingfern",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat", "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "send_metrics": false,
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/oauth",
      "/oauth/*",
      "/.well-known/*",
      "/introduction",
      "/start",
      "/today",
      "/progress",
      "/sitemap",
      "/library",
      "/library/*",
      "/settings",
      "/settings/*",
      "/learn/*"
    ]
  },
  "account_id": "77fd270f4378695c096aaa436175a31b",
  "vars": {
    "GITHUB_CLIENT_ID": "Iv23liV9ye0PF6t8ODeo",
    "GITHUB_APP_SLUG": "lingfern",
    "SYNC_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "lingfern-identity-integration",
      "database_id": "781c9b13-99fe-4c2b-9ae0-230c9a339d4d",
      "migrations_dir": "worker/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "4374809a4e0a48caabb51d7c48388c15"
    }
  ],
  "routes": [
    {
      "pattern": "lingfern.com",
      "custom_domain": true
    }
  ],
  "env": {
    "local": {
      "name": "lingfern-local",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "LOCAL_AUTH": "true"
      },
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "00000000000000000000000000000000"
        }
      ],
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "lingfern-identity-local",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "worker/migrations"
        }
      ],
      "routes": []
    }
  }
}
