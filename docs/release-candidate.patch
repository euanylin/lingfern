+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import path from 'node:path';
+
+export function checkReleaseConfig(config) {
+  assert.equal(config.name, 'lingfern');
+  assert.equal(config.workers_dev, false); assert.equal(config.preview_urls, false);
+  assert(!config.vars?.LOCAL_AUTH, 'LOCAL_AUTH must never reach production');
+  assert.equal(config.vars?.SYNC_ENABLED, 'true', 'First launch requires accepted and enabled sync');
+  assert(/^(?!REQUIRES_APPROVAL$)[A-Za-z0-9_.-]{3,100}$/.test(config.vars?.GITHUB_CLIENT_ID ?? ''), 'Actual App client ID required');
+  assert(!Object.keys(config.vars ?? {}).some(name => /SECRET|ENCRYPTION_KEY|TOKEN/.test(name)), 'Secrets must use protected Worker secrets');
+  const db=config.d1_databases?.find(item=>item.binding==='AUTH_DB'), kv=config.kv_namespaces?.find(item=>item.binding==='OAUTH_KV');
+  assert(/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/.test(db?.database_id ?? '') && /[1-9a-f]/.test(db.database_id), 'Actual D1 ID required');
+  assert.equal(db.migrations_dir,'worker/migrations');
+  assert(/^[a-f0-9]{32}$/.test(kv?.id ?? '') && /[1-9a-f]/.test(kv.id), 'Separate actual OAuth KV required');
+  assert.equal(config.assets?.not_found_handling,'none'); assert(Array.isArray(config.assets.run_worker_first) && !config.assets.run_worker_first.includes('/*'));
+}
+if (process.argv[1] && path.resolve(process.argv[1]) === new URL(import.meta.url).pathname) {
+  checkReleaseConfig(JSON.parse(await readFile('wrangler.jsonc','utf8')));
+  console.log('Production configuration guard passed; real acceptance and deployment approval remain separate.');
+}
--- /dev/null
+++ b/scripts/release-files.mjs
@@ -0,0 +1,39 @@
+import { readdir, readFile, lstat, mkdir, copyFile, writeFile } from 'node:fs/promises';
+import { createHash } from 'node:crypto';
+import path from 'node:path';
+import assert from 'node:assert/strict';
+
+// Export only reviewed source/build inputs; local originals and evidence are never upload inputs.
+const roots = ['src', 'worker', 'scripts', 'tests', 'public', 'content', 'logo', 'docs', '.github'];
+const files = ['Signature/04_Forest_Green.svg', '.gitignore', '.nvmrc', 'AGENTS.md', 'AGENT_WORKFLOW.md', 'DEVELOPMENT_GOAL.md', 'DEVELOPMENT_HANDOFF.md', 'IMPLEMENTATION_STATUS.md', 'Issues.md', 'Product_Plan.md', 'Interface_Design.md', 'README.md', 'Dependency_Notices.md', 'community-content.md', 'design-qa.md', 'UI_Consistency_Audit.md', 'package.json', 'package-lock.json', 'tsconfig.json', 'eslint.config.mjs', 'index.html', 'vite.config.ts', 'playwright.config.ts', 'playwright.offline.config.ts', 'worker-configuration.d.ts', 'wrangler.jsonc'];
+export function allowed(name) {
+  const parts = name.split('/');
+  return !path.isAbsolute(name) && !name.includes('\\') && parts.every(part => part && !['.', '..', 'raw', 'private', 'backup', 'node_modules', 'dist', 'output', 'test-results', 'playwright-report', '.git', '.wrangler', '__pycache__', '.DS_Store'].includes(part) && !/^(\.env|\.dev\.vars)(\.|$)/.test(part) && !/\.(pem|key|p12|pfx|log|tsbuildinfo|m4a|rds|csv|har|zip\.bak)$/i.test(part)) && (files.includes(name) || roots.includes(parts[0])) && !name.startsWith('docs/history/');
+}
+export async function inventory(base) {
+  const entries = [];
+  async function visit(name) {
+    if (!allowed(name)) return;
+    const info = await lstat(path.join(base, name));
+    assert(!info.isSymbolicLink(), `Refusing symlink: ${name}`);
+    if (info.isDirectory()) for (const child of (await readdir(path.join(base, name))).sort()) await visit(`${name}/${child}`);
+    else {
+      assert(info.isFile(), `Refusing nonfile: ${name}`);
+      const bytes = await readFile(path.join(base, name));
+      // Do not print matching content. Synthetic tokens in tests are allowed; real credential signatures are not.
+      assert(!/(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{60,}|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|sk-proj-[A-Za-z0-9_-]{30,})/.test(bytes.toString('utf8')), `Credential signature: ${name}`);
+      entries.push({ path: name, bytes: bytes.length, sha256: createHash('sha256').update(bytes).digest('hex') });
+    }
+  }
+  for (const name of [...files, ...roots]) await visit(name);
+  return entries.sort((a,b) => a.path.localeCompare(b.path));
+}
+if (process.argv[1] && path.resolve(process.argv[1]) === new URL(import.meta.url).pathname) {
+  const target = process.argv[2];
+  assert(target && path.isAbsolute(target), 'Provide a new absolute local export directory');
+  const entries = await inventory(process.cwd());
+  await mkdir(target); // Never overwrite an export or source directory.
+  for (const entry of entries) { const to=path.join(target,entry.path); await mkdir(path.dirname(to),{recursive:true}); await copyFile(entry.path,to); assert.equal(createHash('sha256').update(await readFile(to)).digest('hex'),entry.sha256); }
+  await writeFile(path.join(target,'release-files.json'),JSON.stringify({version:1,scope:'Source/build/portable tests only. Raw sources/private evidence excluded; run the separate source-evidence suite in its retained local environment. No upload or deployment.',files:entries},null,2)+'\n');
+  console.log(`Verified ${entries.length} source files in ${target}`);
+}
