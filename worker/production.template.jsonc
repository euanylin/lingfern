{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lingfern",
  "main": "./index.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "vars": { "GITHUB_CLIENT_ID": "REQUIRES_APPROVAL", "GITHUB_APP_SLUG": "REQUIRES_APPROVAL", "SYNC_ENABLED": "false" },
  "d1_databases": [{"binding": "AUTH_DB", "database_name": "REQUIRES_APPROVAL", "database_id": "REQUIRES_APPROVAL", "migrations_dir": "./migrations"}],
  "kv_namespaces": [{"binding": "OAUTH_KV", "id": "REQUIRES_APPROVAL"}],
  "assets": {
    "directory": "../dist", "binding": "ASSETS", "not_found_handling": "none",
    "run_worker_first": ["/api", "/api/*", "/mcp", "/mcp/*", "/oauth", "/oauth/*", "/.well-known/*", "/introduction", "/start", "/today", "/progress", "/library", "/library/*", "/settings", "/settings/*", "/learn/*"]
  },
  "triggers": {"crons": ["0 3 * * *"]}
}
